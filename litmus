### `litmus.generate()`

```python
def generate(
    docs_dir: str,                          # path to folder of docs
    llm: str = "gpt-4o",                   # litellm model string
    tier: str = "medium",                   # "minimal" | "medium" | "exhaustive"
    size: int | str = "auto",              # "auto" (corpus-aware) | exact int
    save_path: str | None = None,           # save eval set to JSON
    chunking: str = "auto",                 # "auto" | "sentences" | "paragraphs" | callable
    chunk_size: int = 512,                  # tokens per chunk
    chunk_overlap: int = 64,
    seed: int | None = None,
    max_workers: int = 1,                   # sequential by default; set >1 to parallelize LLM calls
    cache_dir: str | None = ".litmus_cache",  # cache + checkpoint dir
    verbose: bool = True,
) -> EvalSet:
```

### `litmus.evaluate()`

```python
def evaluate(
    eval_set: EvalSet | str,                # EvalSet object or path to saved JSON
    rag: Callable[[str], RAGResponse],      # user's RAG function
    llm: str | None = None,                 # judge LLM (defaults to eval_set's LLM)
    scoring: str | list[BinaryQuestion] | None = None,
                                            # None = use tier's default scoring
                                            # "mvp" = force 9 questions / 3 dimensions
                                            # "full" = force 24 questions / 5 dimensions
                                            # list[BinaryQuestion] = custom binary questions
    weights: dict[str, float] | None = None,
                                            # None = use tier's default weights
                                            # e.g. {"faithfulness": 0.50, "correctness": 0.30, "abstention": 0.20}
                                            # for safety-critical domains, push faithfulness higher
    save_path: str | None = None,
    max_workers: int = 1,                   # sequential by default; set >1 to parallelize
    timeout: int = 60,                      # per-question RAG timeout in seconds
    cache_dir: str | None = ".litmus_cache",
    verbose: bool = True,
) -> EvalResults:
```

